/* Runtime structured output with validation and one automatic repair pass. */
allow "../index" in as Sesira

let app = {"provider": "gemini", "model": "gemini-3.5-flash-lite", "memory": false} | Sesira.create
let schema = {
  "type": "object",
  "properties": {
    "sentiment": {"type": "string", "enum": ["positive", "neutral", "negative"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "topics": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["sentiment", "confidence", "topics"],
  "additionalProperties": false
}

let result = "Analyze: Sesi makes data workflows delightfully readable." | Sesira.structured(app, schema)
show result
