/* Stream chunks while retaining the complete response and usage. */
allow "../index" in as Sesira
allow "helpers/ansi" in as TERM

fn on_chunk(chunk) {
  show chunk
}

let app = {
  "provider": "openai",
  "model": "gpt-5.6-luna",
  "memory": false,
  "observability": false
} | Sesira.create

let result = "Explain Sesi pipes in three sentences." | Sesira.stream(app, on_chunk)
TERM.divider("=", 80)
TERM.info("Completed with model: " + result["model"])