/* Stream chunks while retaining the complete response and usage. */
allow "../index" in as Sesira

fn on_chunk(chunk) {
  show chunk
}

let app = {
  "provider": "openai",
  "model": "gpt-5.6-terra",
  "memory": false,
  "observability": false
} | Sesira.create

let result = "Explain Sesi pipes in three sentences." | Sesira.stream(app, on_chunk)
show ""
show "Completed with model:" result["model"]
