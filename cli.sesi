/* SesiraAPI command-line interface. */
allow "index" in as Sesira
allow "std/terminal" in as Terminal

fn show_help() {
  show Terminal.color("SesiraAPI", "cyan", "bold") "— native Sesi AI application framework"
  show ""
  show "Usage: sesi SesiraAPI/cli.sesi <command> [arguments]"
  show ""
  show "Commands:"
  show "  init                 Create sesira.json and app.sesi"
  show "  doctor               Validate configuration and provider credentials"
  show "  providers            List native provider adapters"
  show "  ask <message>        Send one message and show the response"
  show "  chat                 Start an interactive persistent chat"
  show "  help                 Show this help"
}

fn write_if_missing(path: string, content: string, force: bool) -> bool {
  let exists = false
  try {
    let current = read_file(path)
    if current != null { exists = true }
  } catch (error) {}
  if exists && !force {
    show "  skip" path "(already exists; pass --force to replace)"
    return false
  }
  try {
    write_file(path, content)
    show "  create" path
    return true
  } catch (error) {
    show Terminal.color("  error " + path + ": " + str(error), "red")
    return false
  }
}

fn init_project(force: bool) {
  let config = "{\n  \"name\": \"my-sesira-app\",\n  \"provider\": \"gemini\",\n  \"model\": \"gemini-3.6-flash\",\n  \"system\": \"You are a helpful assistant.\",\n  \"temperature\": 0.2,\n  \"memory_path\": \".sesira/memory.db\",\n  \"observability\": true\n}\n"
  let app = "allow \"SesiraAPI\" in with Sesira\n\nlet app = {\"config_path\": \"sesira.json\"} | Sesira.create\nlet question = \"What can you help me build?\"\nlet answer = question | Sesira.ask(app)\nshow answer\n"
  show "Initializing a native Sesi AI application:"
  write_if_missing("sesira.json", config, force)
  write_if_missing("app.sesi", app, force)
  show ""
  show "Next: set your provider key, then run `sesi app.sesi`."
}

fn doctor() {
  show Terminal.color("SesiraAPI doctor", "cyan", "bold")
  let config = null
  try {
    config = Sesira.load_config("sesira.json")
    show "✓ configuration is valid"
  } catch (error) {
    show Terminal.color("✗ configuration error: " + str(error), "red")
    return
  }
  show "✓ provider:" config["provider"]
  show "✓ model:" config["model"]
  let provider_name = to_lower(config["provider"])
  if provider_name == "gemini" {
    if env("GEMINI_API_KEY") == null { show Terminal.color("✗ GEMINI_API_KEY is missing", "yellow") } else { show "✓ GEMINI_API_KEY is set" }
  } else if provider_name == "openai" || provider_name == "gpt" {
    if env("OPENAI_API_KEY") == null { show Terminal.color("✗ OPENAI_API_KEY is missing", "yellow") } else { show "✓ OPENAI_API_KEY is set" }
  } else if provider_name == "local" {
    show "✓ local provider does not require an API key"
  } else {
    show "• custom/Sesi provider credential checks are delegated to the runtime"
  }
  show "✓ memory path:" config["memory_path"]
  show "✓ observability:" config["observability"]
}

fn show_providers() {
  show "Provider     Default model             Credential"
  show "-------------------------------------------------------------"
  for item in Sesira.supported_providers() {
    show item["name"] "         " item["default_model"] "         " item["key_env"]
  }
}

fn ask_once(words: array) {
  if len(words) == 0 {
    show "Usage: sesira ask <message>"
    return
  }
  let app = {"config_path": "sesira.json"} | Sesira.create
  let answer = join(words, " ") | Sesira.ask(app)
  show answer
}

fn chat_loop() {
  let app = {"config_path": "sesira.json"} | Sesira.create
  show Terminal.color("SesiraAPI chat", "cyan", "bold")
  show "Type /exit to quit or /memory <query> to inspect retrieval."
  let active = true
  while active {
    let line = input("you> ")
    if line == "/exit" || line == "/quit" {
      active = false
    } else if contains(line, "/memory ") {
      let query = trim(swap(line, "/memory ", ""))
      let found = query | Sesira.retrieve(app)
      show found["context"]
    } else if trim(line) != "" {
      let response = line | Sesira.ask(app)
      show "assistant>" response
    }
  }
}

let command = "help"
if len(args) > 0 { command = to_lower(args[0]) }
let force = includes(args, "--force")

if command == "init" { init_project(force) } else if command == "doctor" { doctor() } else if command == "providers" { show_providers() } else if command == "ask" { ask_once(slice(args, 1)) } else if command == "chat" { chat_loop() } else { show_help() }
