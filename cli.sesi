/* SesiraAPI command-line interface. */
allow "index" in with Sesira
allow "std/terminal" in with Terminal

fn show_help() {
  print Terminal.color("SesiraAPI", "cyan", "bold") "— native Sesi AI application framework"
  print ""
  print "Usage: sesi SesiraAPI/cli.sesi <command> [arguments]"
  print ""
  print "Commands:"
  print "  init                 Create sesira.json and app.sesi"
  print "  doctor               Validate configuration and provider credentials"
  print "  providers            List native provider adapters"
  print "  ask <message>        Send one message and print the response"
  print "  chat                 Start an interactive persistent chat"
  print "  help                 Show this help"
}

fn write_if_missing(path: string, content: string, force: bool) -> bool {
  let exists = false
  try {
    let current = read_file(path)
    if current != null { exists = true }
  } catch (error) {}
  if exists && !force {
    print "  skip" path "(already exists; pass --force to replace)"
    return false
  }
  try {
    write_file(path, content)
    print "  create" path
    return true
  } catch (error) {
    print Terminal.color("  error " + path + ": " + str(error), "red")
    return false
  }
}

fn init_project(force: bool) {
  let config = "{\n  \"name\": \"my-sesira-app\",\n  \"provider\": \"gemini\",\n  \"model\": \"gemini-3.6-flash\",\n  \"system\": \"You are a helpful assistant.\",\n  \"temperature\": 0.2,\n  \"memory_path\": \".sesira/memory.db\",\n  \"observability\": true\n}\n"
  let app = "allow \"SesiraAPI\" in with Sesira\n\nlet app = {\"config_path\": \"sesira.json\"} | Sesira.create\nlet question = \"What can you help me build?\"\nlet answer = question | Sesira.ask(app)\nprint answer\n"
  print "Initializing a native Sesi AI application:"
  write_if_missing("sesira.json", config, force)
  write_if_missing("app.sesi", app, force)
  print ""
  print "Next: set your provider key, then run `sesi app.sesi`."
}

fn doctor() {
  print Terminal.color("SesiraAPI doctor", "cyan", "bold")
  let config = null
  try {
    config = Sesira.load_config("sesira.json")
    print "✓ configuration is valid"
  } catch (error) {
    print Terminal.color("✗ configuration error: " + str(error), "red")
    return
  }
  print "✓ provider:" config["provider"]
  print "✓ model:" config["model"]
  let provider_name = to_lower(config["provider"])
  if provider_name == "gemini" {
    if env("GEMINI_API_KEY") == null { print Terminal.color("✗ GEMINI_API_KEY is missing", "yellow") } else { print "✓ GEMINI_API_KEY is set" }
  } else if provider_name == "openai" || provider_name == "gpt" {
    if env("OPENAI_API_KEY") == null { print Terminal.color("✗ OPENAI_API_KEY is missing", "yellow") } else { print "✓ OPENAI_API_KEY is set" }
  } else if provider_name == "local" {
    print "✓ local provider does not require an API key"
  } else {
    print "• custom/Sesi provider credential checks are delegated to the runtime"
  }
  print "✓ memory path:" config["memory_path"]
  print "✓ observability:" config["observability"]
}

fn show_providers() {
  print "Provider     Default model             Credential"
  print "-------------------------------------------------------------"
  for item in Sesira.supported_providers() {
    print item["name"] "         " item["default_model"] "         " item["key_env"]
  }
}

fn ask_once(words: array) {
  if len(words) == 0 {
    print "Usage: sesira ask <message>"
    return
  }
  let app = {"config_path": "sesira.json"} | Sesira.create
  let answer = join(words, " ") | Sesira.ask(app)
  print answer
}

fn chat_loop() {
  let app = {"config_path": "sesira.json"} | Sesira.create
  print Terminal.color("SesiraAPI chat", "cyan", "bold")
  print "Type /exit to quit or /memory <query> to inspect retrieval."
  let active = true
  while active {
    let line = input("you> ")
    if line == "/exit" || line == "/quit" {
      active = false
    } else if contains(line, "/memory ") {
      let query = trim(swap(line, "/memory ", ""))
      let found = query | Sesira.retrieve(app)
      print found["context"]
    } else if trim(line) != "" {
      let response = line | Sesira.ask(app)
      print "assistant>" response
    }
  }
}

let command = "help"
if len(args) > 0 { command = to_lower(args[0]) }
let force = includes(args, "--force")

if command == "init" { init_project(force) } else if command == "doctor" { doctor() } else if command == "providers" { show_providers() } else if command == "ask" { ask_once(slice(args, 1)) } else if command == "chat" { chat_loop() } else { show_help() }
