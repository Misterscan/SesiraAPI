/* Sesira application runtime: chat, streaming, memory, retrieval, and traces. */
allow "utils" in as Utils
allow "config" in as Config
allow "providers" in as Providers
allow "messages" in as Messages
allow "memory" in as Memory
allow "retrieval" in as Retrieval
allow "schema" in as Schema
allow "observability" in as Observe

/**
  Create a new Sesira application runtime with chat, streaming, memory, retrieval, and observability capabilities.

  Parameters:
  - overrides: An object containing optional configuration overrides for the application, including:
    - config_path: The path to the configuration file (default is "sesira.json").

  Returns:
  - An object representing the created application with its configuration, provider, memory store, and observer.

  Example:

  ```sesi
  let my_app = create({"config_path": "sesira.json"})
  ```

  Output:
  ```sesi
  {
    "name": "sesira-app",
    "config": {...},
    "provider": {...},
    "memory": {...},
    "observer": {...}
  }
  ```
*/
export fn create(overrides: object = null) -> object {
  let path = Utils.pick(overrides, "config_path", "sesira.json")
  let config = Config.load(path, overrides)
  let adapter = Providers.from_config(config)
  let memory_store = null
  if Utils.pick(config, "memory", true) == true {
    memory_store = Memory.bank({
      "path": config["memory_path"],
      "namespace": config["memory_namespace"],
      "password": config["memory_password"],
      "short_limit": config["short_memory_limit"]
    })
  }
  let observer = Observe.observer({
    "enabled": config["observability"],
    "path": config["log_path"]
  })
  let app = {
    "name": Utils.pick(config, "name", "sesira-app"),
    "config": config,
    "provider": adapter,
    "memory": memory_store,
    "observer": observer
  }
  Observe.emit(observer, "app.created", {
    "name": app["name"],
    "provider": adapter["name"],
    "model": adapter["model"]
  })
  return app
}

/**
  Get the last user message text from a list of messages.

  Parameters:
  - messages: An array of message objects.

  Returns:
  - The text content of the last user message, or an empty string if none exists.
*/
fn last_user_text(messages: array) -> string {
  let result = ""
  for item in messages {
    if item["role"] == "user" { result = Messages.content_text(item["content"]) }
  }
  return result
}

/**
  Get the recent prompt text from the short-term memory store.

  Parameters:
  - memory_store: The memory store object containing short-term memory.

  Returns:
  - A string representing the recent prompt text, including roles and content of recent messages.
*/
fn recent_prompt(memory_store) -> string {
  if memory_store == null { return "" }
  let output = ""
  for item in Memory.recent(memory_store["short"]) {
    output = output + to_upper(item["role"]) + ": " + item["content"] + "\n"
  }
  return output
}

/**
  Extract image paths from a list of messages.

  Parameters:
  - messages: An array of message objects.

  Returns:
  - An array of strings representing the paths of images found in the messages.
*/
fn image_paths(messages: array) -> array {
  let paths = []
  for item in messages {
    if type(item["content"]) == "array" {
      for part in item["content"] {
        if type(part) == "object" && part["type"] == "image" { push(paths, part["path"]) }
      }
    }
  }
  return paths
}

/**
  Perform a chat interaction with the application, sending user input and receiving a response.

  Parameters:
  - app: The application object containing configuration, provider, memory, and observer.
  - input: The user input message(s) to be processed.
  - options: An optional object containing additional options for the chat, such as retrieval limits and streaming callbacks.

  Returns:
  - An object representing the chat response, including the generated text, retrieval context, and usage information.

  Example:

  ```sesi
  let response = chat(my_app, "Hello, how are you?", {"retrieval_limit": 5})
  ```

  Output:
  ```sesi
  {
    "text": "I'm doing well, thank you!",
    "retrieval": [...],
    "usage": {...}
  }
  ```
*/
export fn chat(app: object, input, options: object = null) -> object {
  let messages = Messages.normalize(input)
  let question = last_user_text(messages)
  let span = Observe.start_span(app["observer"], "chat", {"message_count": len(messages)})
  let system_text = Messages.system_text(messages)
  if system_text == "" { system_text = app["provider"]["system"] }
  let retrieved = {"context": "", "relevant": [], "recent": []}
  if app["memory"] != null && question != "" {
    retrieved = Memory.retrieve(app["memory"], question, {
      "limit": Utils.pick(options, "retrieval_limit", app["config"]["retrieval_limit"]),
      "min_score": Utils.pick(options, "min_score", 0.05)
    })
    if retrieved["context"] != "" {
      system_text = system_text + "\n\nRelevant memory (use only when helpful):\n" + retrieved["context"]
    }
  }
  let prompt_text = recent_prompt(app["memory"]) + Messages.render(Messages.without_system(messages)) + "ASSISTANT:"
  let call_options = Utils.copy_object(options)
  call_options["system"] = system_text
  let images = image_paths(messages)
  if len(images) > 0 { call_options["images"] = images }
  try {
    let response = Providers.complete(app["provider"], prompt_text, call_options)
    response["retrieval"] = retrieved["relevant"]
    if app["memory"] != null {
      if question != "" { Memory.add_turn(app["memory"], "user", question) }
      Memory.add_turn(app["memory"], "assistant", response["text"], {
        "model": response["model"],
        "completion_id": response["id"]
      })
    }
    Observe.end_span(app["observer"], span, {
      "model": response["model"],
      "duration_ms": response["duration_ms"],
      "usage": response["usage"]
    })
    return response
  } catch (error) {
    Observe.record_error(app["observer"], span, error)
    raise_error("ProviderError", str(error), {"provider": app["provider"]["name"]})
  }
  return null
}

/**
  Ask the application a question and receive a text response.

  Parameters:
  - app: The application object containing configuration, provider, memory, and observer.
  - input: The user input message(s) to be processed.
  - options: An optional object containing additional options for the chat, such as retrieval limits and streaming callbacks.

  Returns:
  - A string representing the generated response text from the application.

  Example:

  ```sesi
  let answer = ask(my_app, "What is the capital of France?", {"retrieval_limit": 5})
  ```

  Output:
  ```sesi
  "The capital of France is Paris."
  ```
*/
export fn ask(app: object, input, options: object = null) -> string {
  return chat(app, input, options)["text"]
}

/**
  Stream a chat interaction with the application, sending user input and receiving partial responses via a callback.

  Parameters:
  - app: The application object containing configuration, provider, memory, and observer.
  - input: The user input message(s) to be processed.
  - on_chunk: A callback function to handle partial response chunks.
  - options: An optional object containing additional options for the chat, such as retrieval limits and streaming callbacks.

  Returns:
  - An object representing the final chat response, including the generated text, retrieval context, and usage information.
  
  Example:

  ```sesi
  fn on_chunk(chunk) { show chunk }
  let response = stream("Hello, how are you?", my_app, on_chunk, {"retrieval_limit": 5})
  ```

  Output:
  ```sesi
  {
    "text": "I'm doing well, thank you!",
    "retrieval": [...],
    "usage": {...}
  }
  ```
*/
export fn stream(app: object, input, on_chunk, options: object = null) -> object {
  let stream_options = Utils.copy_object(options)
  stream_options["stream"] = on_chunk
  return chat(app, input, stream_options)
}

/**
  Generate structured output from the application based on a prompt and a schema.

  Parameters:
  - app: The application object containing configuration, provider, memory, and observer.
  - prompt_text: The prompt text to be processed.
  - schema: The schema defining the expected structure of the output.
  - options: An optional object containing additional options for the structured generation.

  Returns:
  - The generated structured output according to the provided schema.

  Example:

  ```sesi
  let result = structured("Extract the name and age from the text.", my_app, my_schema, {"temperature": 0})
  ```

  Output:
  ```sesi
  {
    "name": "John Doe",
    "age": 30
  }
  ```
*/
export fn structured(app: object, prompt_text: string, schema, options: object = null) {
  let span = Observe.start_span(app["observer"], "structured.generate", {})
  try {
    let result = Schema.generate(app["provider"], prompt_text, schema, options)
    Observe.end_span(app["observer"], span, {"valid": true})
    return result
  } catch (error) {
    Observe.record_error(app["observer"], span, error)
    raise_error("StructuredOutputError", str(error), null)
  }
  return null
}

/**
  Retrieve relevant information from the application's memory based on a query.

  Parameters:
  - app: The application object containing configuration, provider, memory, and observer.
  - query: The query string to search for in the memory.
  - options: An optional object containing additional options for the retrieval.

  Returns:
  - An object containing the recent and relevant memory entries, as well as the context.

  Example:

  ```sesi
  let memory_result = retrieve(my_app, "What is the capital of France?", {"retrieval_limit": 5})
  ```

  Output:
  ```sesi
  {
    "recent": [...],
    "relevant": [...],
    "context": "The capital of France is Paris."
  }
  ```
*/
export fn retrieve(app: object, query: string, options: object = null) -> object {
  if app["memory"] == null {
    return {"recent": [], "relevant": [], "context": ""}
  }
  return Memory.retrieve(app["memory"], query, options)
}

/**
  Index a list of documents into the application's memory, splitting them into chunks as needed.

  Parameters:
  - app: The application object containing configuration, provider, memory, and observer.
  - documents: An array of documents to be indexed.
  - options: An optional object containing additional options for the indexing, such as chunking parameters.

  Returns:
  - The number of chunks successfully indexed into memory.

  Example:

  ```sesi
  let documents = [document("Paris is the capital of France.", {"source": "encyclopedia"})]
  let indexed_count = index_documents(documents, my_app, {"chunk_size": 100})
  ```

  Output:
  ```sesi
  1
  ```
*/
export fn index_documents(app: object, documents: array, options: object = null) -> number {
  if app["memory"] == null { raise_error("MemoryError", "Application memory is disabled", null) }
  let count = 0
  for doc in documents {
    let chunks = Retrieval.chunk(doc, options)
    for item in chunks {
      Memory.remember(app["memory"]["long"], item["content"], item["metadata"], item["id"])
      count = count + 1
    }
  }
  Observe.emit(app["observer"], "retrieval.indexed", {"chunks": count})
  return count
}