/* Native Sesi provider adapters over model(). */
allow "utils" in as Utils

/**
  Creates a provider configuration object based on the specified kind and options.

  Parameters:
  - `kind`: The type of provider (e.g., "gemini", "openai", "local", "sesi", "custom").
  - `options`: An optional object containing provider-specific configuration options.
    - `name`: The name of the provider. This is derived from the `kind` parameter and normalized to lowercase.
    - `model`: The model to be used by the provider. Defaults are set based on the `kind` of provider.
    - `system`: The system prompt or instructions for the provider.
    - `temperature`: The sampling temperature for the model. Defaults to 0.2.
    - `max_tokens`: The maximum number of tokens to generate. Defaults to 4096.
    - `thinking`: The thinking level for the model. Defaults to "low".
    - `search`: Whether to enable search functionality. Defaults to `false`.
    - `cache`: Whether to enable caching. Defaults to `true`.
    - `stream`: Whether to enable streaming responses. Defaults to `false`.
    - `images`: An array of images associated with the provider. Defaults to an empty array.
    - `tools`: An array of tools associated with the provider. Defaults to an empty array.

  Returns:
  - A provider configuration object containing the merged settings.

  Example:
  ```sesi
  let config = provider("openai", {
    "system": "You are a helpful assistant.",
    "temperature": 0.5,
    "max_tokens": 500,
    "thinking": "low",
    "search": false,
    "cache": true,
    "stream": false,
    "images": [],
    "tools": [fixErrors, autoComplete, summarize, analyze]
  })
  ```

  Output:
  ```sesi
  {
    "name": "openai",
    "model": "gpt-5.6-terra",
    "system": "You are a helpful assistant.",
    "temperature": 0.5,
    "max_tokens": 500,
    "thinking": "low",
    "search": false,
    "cache": true,
    "stream": false,
    "images": [],
    "tools": [fixErrors, autoComplete, summarize, analyze]
  }
  ```
*/
export fn provider(kind: string, options: object = null) -> object {
  let normalized = to_lower(trim(kind))
  let base = {
    "name": normalized,
    "model": "",
    "system": "",
    "temperature": 0.3,
    "max_tokens": 4096,
    "thinking": "medium",
    "search": false,
    "cache": true,
    "stream": false,
    "images": [],
    "tools": []
  }
  if normalized == "gemini" { base["model"] = "gemini-3.7-flash" }
  if normalized == "openai" || normalized == "gpt" { base["model"] = "gpt-5.6-terra" }
  if normalized == "local" { base["model"] = "local" }
  if normalized == "sesi" { base["model"] = "agent" }
  if normalized == "custom" { base["model"] = Utils.pick(options, "model", null) }
  if base["model"] == "" || base["model"] == null {
    raise_error("ConfigurationError", "Unsupported provider adapter: " + kind, {
      "supported": ["gemini", "openai", "local", "sesi", "custom"]
    })
  }
  let result = Utils.merge(base, options)
  result["name"] = normalized
  return result
}

/**
  Creates a provider configuration object from a given configuration object.

  Parameters:
  - `config`: The configuration object containing provider settings.

  Returns:
  - A provider configuration object based on the provided configuration.

  Example:
  ```sesi
  let config = from_config({"provider": "openai", "temperature": 0.5})
  ```

  Output:
  ```sesi
  {
    "name": "openai",
    "model": "gpt-5.6-terra",
    "system": "",
    "temperature": 0.5,
    "max_tokens": 4096,
    "thinking": "medium",
    "search": false,
    "cache": true,
    "stream": false,
    "images": [],
    "tools": []
  }
  ```
*/
export fn from_config(config: object) -> object {
  return provider(str(config["provider"]), config)
}

/**
  Sends a completion request to the specified provider adapter with the given prompt and options.

  Parameters:
  - `adapter`: The provider adapter configuration object.
  - `prompt_text`: The prompt text to be completed.
  - `options`: An optional object containing additional completion options.

  Returns:
  - An object containing the completion result, including the generated text, usage information, and duration.

  Example:
  ```sesi
  let config = from_config({"provider": "openai", "temperature": 0.5})
  let result = complete(config, "Explain the concept of provider adapters.")
  ```

  Output:
  ```sesi
  {
    "id": "<generated_id>",
    "provider": "openai",
    "model": "gpt-5.6-terra",
    "text": "Explain the concept of provider adapters.",
    "usage": {...},
    "duration_ms": <time_taken>
  }
  ```
*/
export fn complete(adapter: object, prompt_text: string, options: object = null) -> object {
  let settings = Utils.merge(adapter, options)
  let started = time()
  let sesiRef = ""; try { sesiRef = read_file("./src/BUILTINS.md") } catch (e) {show "Warning: Could not read SesiraAPI/src/BUILTINS.md for reference."}
  let sys = "SESI LANGUAGE REFERENCES:\n" + sesiRef + "\n" + settings["system"]
  let text = ""
  if settings["name"] == "openai" || settings["name"] == "gpt" {
    text = model(settings["model"]) {max_tokens: settings["max_tokens"], thinkingLevel: settings["thinking"], system: sys, search: settings["search"], cache: settings["cache"], stream: settings["stream"], images: settings["images"], tools: settings["tools"]} {prompt_text}
  } else {
    text = model(settings["model"]) {temperature: settings["temperature"], max_tokens: settings["max_tokens"], thinkingLevel: settings["thinking"], system: sys, search: settings["search"], cache: settings["cache"], stream: settings["stream"], images: settings["images"], tools: settings["tools"]} {prompt_text}
  }
  let usage = model_usage()
  return {
    "id": Utils.make_id("completion"),
    "provider": settings["name"],
    "model": settings["model"],
    "text": text,
    "usage": usage,
    "duration_ms": time() - started
  }
}

/**
  Sends a streaming completion request to the specified provider adapter with the given prompt and chunk handler.

  Parameters:
  - `adapter`: The provider adapter configuration object.
  - `prompt_text`: The prompt text to be completed.
  - `on_chunk`: A callback function to handle each chunk of the streaming response.
  - `options`: An optional object containing additional completion options.

  Returns:
  - An object containing the completion result, including the generated text, usage information, and duration.

  Example:
  ```sesi
  fn on_chunk(chunk) {show chunk}
  let config = from_config({"provider": "openai", "temperature": 0.5})
  let result = stream(config, "Explain the concept of provider adapters.", on_chunk)
  ```

  Output:
  ```sesi
  {
    "id": "<generated_id>",
    "provider": "openai",
    "model": "gpt-5.6-terra",
    "text": "Explain the concept of provider adapters.",
    "usage": {...},
    "duration_ms": <time_taken>
  }
  ```
*/
export fn stream(adapter: object, prompt_text: string, on_chunk, options: object = null) -> object {
  let stream_options = Utils.copy_object(options)
  stream_options["stream"] = on_chunk
  return complete(adapter, prompt_text, stream_options)
}

/**
  Returns an array of supported provider configurations, including their names, environment variable keys for API keys, and default models.

  Returns:
  - An array of objects representing the supported providers.

  Output:
  ```sesi
  [
    {"name": "gemini", "key_env": "GEMINI_API_KEY", "default_model": "gemini-3.7-flash"},
    {"name": "openai", "key_env": "OPENAI_API_KEY", "default_model": "gpt-5.6-terra"},
    {"name": "local", "key_env": null, "default_model": "local"},
    {"name": "sesi", "key_env": null, "default_model": "agent"},
    {"name": "custom", "key_env": "provider-specific", "default_model": null}
  ]
  ```
*/
export fn supported() -> array {
  return [
    {"name": "gemini", "key_env": "GEMINI_API_KEY", "default_model": "gemini-3.7-flash"},
    {"name": "openai", "key_env": "OPENAI_API_KEY", "default_model": "gpt-5.6-terra"},
    {"name": "local", "key_env": null, "default_model": "local"},
    {"name": "sesi", "key_env": null, "default_model": "agent"},
    {"name": "custom", "key_env": "provider-specific", "default_model": null}
  ]
}