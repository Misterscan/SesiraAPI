/* Lightweight traces, events, JSONL logging, and aggregate metrics. */
allow "utils" in as Utils

// Internal helper to ensure the parent directory for a log file exists.
fn ensure_log_parent(path: string) {
  if !contains(path, "/") { return }
  let parts = split(path, "/")
  let parent = join(slice(parts, 0, len(parts) - 1), "/")
  if parent != "" { try { make_dir(parent) } catch (error) {} }
}

/**
  Create a new observer for logging and tracing.

  Parameters:
  - options: An optional object containing observer configuration, including:
    - path: The file path for JSONL logging.
    - enabled: A boolean indicating if the observer is enabled.
    - trace_id: An optional trace ID for the observer.

  Returns:
  - An observer object containing "enabled", "path", "trace_id", and "events".

  Example:
  ```sesi
  let obs = observer({"path": "logs.jsonl", "enabled": true})
  ```

  Output:
  ```sesi
  {"enabled": true, "path": "logs.jsonl", "trace_id": "<some_trace_id>", "events": []}
  ```
*/
export fn observer(options: object = null) -> object {
  let path = Utils.pick(options, "path", "")
  if path != "" && Utils.pick(options, "enabled", true) == true { ensure_log_parent(path) }
  return {
    "enabled": Utils.pick(options, "enabled", true),
    "path": path,
    "trace_id": Utils.pick(options, "trace_id", Utils.make_id("trace")),
    "events": []
  }
}

/**
  Emit an event to the observer.

  Parameters:
  - target: The observer object.
  - name: The name of the event.
  - attributes: An optional object containing event attributes.

  Returns:
  - The emitted event object.

  Example:
  ```sesi
  let obs = observer({"path": "logs.jsonl", "enabled": true})
  let event = emit(obs, "user.login", {"user": "Alice"})
  ```

  Output:
  ```sesi
  {"name": "user.login", "timestamp": 0, "trace_id": "<some_trace_id>", "attributes": {"user": "Alice"}}
  ```
*/
export fn emit(target: object, name: string, attributes: object = null) -> object {
  if attributes == null { attributes = {} }
  let event = {
    "name": name,
    "timestamp": time(),
    "trace_id": target["trace_id"],
    "attributes": attributes
  }
  if target["enabled"] != true { return event }
  push(target["events"], event)
  if target["path"] != null && target["path"] != "" {
    // Telemetry is best-effort and must never change application behavior.
    try { append_file(target["path"], to_json(event) + "\n") } catch (log_error) {}
  }
  return event
}

/**
  Start a new span for tracing.

  Parameters:
  - target: The observer object.
  - name: The name of the span.
  - attributes: An optional object containing span attributes.

  Returns:
  - The created span object.

  Example:
  ```sesi
  let obs = observer({"path": "logs.jsonl", "enabled": true})
  let span = start_span(obs, "database.query", {"query": "SELECT * FROM users"})
  ```

  Output:
  ```sesi
  {"id": "<some_span_id>", "name": "database.query", "started_at": 0, "attributes": {"query": "SELECT * FROM users"}}
  ```
*/
export fn start_span(target: object, name: string, attributes: object = null) -> object {
  if attributes == null { attributes = {} }
  let span = {
    "id": Utils.make_id("span"),
    "name": name,
    "started_at": time(),
    "attributes": attributes
  }
  emit(target, "span.start", {
    "span_id": span["id"],
    "span_name": name,
    "attributes": attributes
  })
  return span
}

/**
  End a span for tracing.

  Parameters:
  - target: The observer object.
  - span: The span object to end.
  - attributes: An optional object containing span attributes.

  Returns:
  - The span end event data object.

  Example:
  ```sesi
  let obs = observer({"path": "logs.jsonl", "enabled": true})
  let span = start_span(obs, "database.query", {"query": "SELECT * FROM users"})
  let end_event = end_span(obs, span, {"rows": 10})
  ```

  Output:
  ```sesi
  {"span_id": "<some_span_id>", "span_name": "database.query", "duration_ms": 0, "attributes": {"rows": 10}}
  ```
*/
export fn end_span(target: object, span: object, attributes: object = null) -> object {
  if attributes == null { attributes = {} }
  let duration = time() - span["started_at"]
  let data = {
    "span_id": span["id"],
    "span_name": span["name"],
    "duration_ms": duration,
    "attributes": attributes
  }
  emit(target, "span.end", data)
  return data
}

/**
  Record an error for a span.

  Parameters:
  - target: The observer object.
  - span: The span object associated with the error.
  - error: The error object or message.

  Returns:
  - The emitted error event object.

  Example:
  ```sesi
  let obs = observer({"path": "logs.jsonl", "enabled": true})
  let span = start_span(obs, "database.query", {"query": "SELECT * FROM users"})
  let error_event = record_error(obs, span, "Database connection failed")
  ```

  Output:
  ```sesi
  {"span_id": "<some_span_id>", "span_name": "database.query", "error": "Database connection failed", "error_type": "RuntimeError"}
  ```
*/
export fn record_error(target: object, span: object, error) -> object {
  return emit(target, "span.error", {
    "span_id": span["id"],
    "span_name": span["name"],
    "error": str(error),
    "error_type": "RuntimeError"
  })
}

/**
  Retrieve metrics from the observer.

  Parameters:
  - target: The observer object.

  Returns:
  - An object containing aggregated metrics such as event counts, errors, and total duration.

  Example:
  ```sesi
  let obs = observer({"path": "logs.jsonl", "enabled": true})
  let span = start_span(obs, "database.query", {"query": "SELECT * FROM users"})
  end_span(obs, span, {"rows": 10})
  let metrics_data = metrics(obs)
  ```

  Output:
  ```sesi
  {"trace_id": "<some_trace_id>", "events": 2, "errors": 0, "duration_ms": 0, "counts": {"span.start": 1, "span.end": 1}}
  ```
*/
export fn metrics(target: object) -> object {
  let counts = {}
  let errors = 0
  let duration = 0
  for event in target["events"] {
    let name = event["name"]
    if counts[name] == null { counts[name] = 0 }
    counts[name] = counts[name] + 1
    if name == "span.error" { errors = errors + 1 }
    if name == "span.end" { duration = duration + event["attributes"]["duration_ms"] }
  }
  return {
    "trace_id": target["trace_id"],
    "events": len(target["events"]),
    "errors": errors,
    "duration_ms": duration,
    "counts": counts
  }
}